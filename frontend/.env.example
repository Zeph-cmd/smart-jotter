NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
OPENAI_API_KEY=
DEEPGRAM_API_KEY=
# Required for auto-confirming Smart Jotter signups (shared Supabase project).
# Get it from: Supabase Dashboard > Project Settings > API > service_role key
SUPABASE_SERVICE_ROLE_KEY=

# Paystack — payments for Speech-to-Text & AI Writing Assist subscriptions.
# Both keys from: Paystack Dashboard > Settings > API Keys & Webhooks.
# SECRET key is server-side only (verify transactions + sign webhooks).
PAYSTACK_SECRET_KEY=
# PUBLIC key is exposed to the browser to open the Paystack inline popup.
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
